{
  "name": "irondocs-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -C typescript build && pnpm -C python build",
    "deps": "ncu -ws --root -u --cooldown 7d",
    "docs:build": "livemark build",
    "docs:start": "livemark start",
    "format": "vp fmt --no-error-on-unmatched-pattern && pnpm -C python format",
    "lint": "vp fmt --check && vp lint && pnpm -C python lint",
    "prepare": "lefthook install && mkdir -p .claude && ln -sfn ../.agents/skills .claude/skills && (command -v uv >/dev/null && pnpm -C python setup || true)",
    "test": "pnpm lint && pnpm type && pnpm unit",
    "type": "pnpm -C typescript type && pnpm -C python type",
    "unit": "pnpm -C typescript unit && pnpm -C python unit",
    "leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/python --config=p/owasp-top-ten --config=p/secrets --exclude=\"**/fixtures/**\" --metrics=off",
    "scan": "pnpm leaks && pnpm vulns"
  },
  "devDependencies": {
    "@plausible-analytics/tracker": "^0.4.4",
    "@tanstack/react-router": "1.168.1",
    "@tanstack/react-start": "1.167.2",
    "@types/node": "24.2.0",
    "cn": "0.2.4",
    "lefthook": "2.1.1",
    "livemark": "0.13.0",
    "lucide-react": "0.577.0",
    "npm-check-updates": "23.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.85.0"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}

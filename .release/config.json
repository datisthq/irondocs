{
  "separate-pull-requests": false,
  "packages": {
    "typescript": {
      "release-type": "node",
      "include-component-in-tag": false
    },
    "python": {
      "release-type": "python",
      "package-name": "irondocs",
      "component": "python",
      "include-component-in-tag": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance Improvements"
        },
        {
          "type": "deps",
          "section": "Dependencies"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value === 'irondocs')].version"
        }
      ]
    }
  }
}
